# OptiCart Server Configuration Templates
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Generate secrets using: openssl rand -base64 64
JWT_ACCESS_SECRET=replace_with_a_long_secure_openssl_generated_access_token_secret_key
JWT_REFRESH_SECRET=replace_with_a_distinct_long_secure_openssl_generated_refresh_token_secret_key

# MongoDB Connection URI
MONGO_URI=mongodb://localhost:27017/opticart

# Third-party Integrations (Mocked in stub services)
STRIPE_SECRET_KEY=sk_test_...
CLOUDINARY_URL=cloudinary://...
