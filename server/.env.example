# OptiCart server environment — copy to .env and fill in.
# Mock-friendly defaults: with the values below the app runs fully offline
# (mock Stripe, mock Cloudinary, console-logged emails).

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/opticart

# REQUIRED in production — the server refuses to start without it.
# In development a warning + insecure fallback is used if left empty.
JWT_ACCESS_SECRET=

CLIENT_URL=http://localhost:5173

# Stripe: keep the mock key for demos; set a real sk_test_... key for live
# Stripe test mode. With a real key, STRIPE_WEBHOOK_SECRET is required —
# unsigned webhook calls are rejected (fail-closed).
STRIPE_SECRET_KEY=sk_test_mock_key
STRIPE_WEBHOOK_SECRET=

# Cloudinary: cloudinary://mock returns fake URLs; a real CLOUDINARY_URL
# (cloudinary://key:secret@cloud) enables actual uploads.
CLOUDINARY_URL=cloudinary://mock

# Google sign-in (optional): OAuth client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=

# Email (optional): Gmail app password is the easiest; any SMTP also works.
# Without credentials, emails are logged to the server console.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="OptiCart <no-reply@example.com>"

NODE_ENV=development
